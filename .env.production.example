# ==============================================================================
# RHD-ADDS (Automated Design Data System) — Production Environment Configuration
# Roads and Highways Department (RHD), Bangladesh
# ==============================================================================

# Server Network & Runtime
PORT=8787
ENVIRONMENT=production
SECRET_KEY=rhd-adds-precision-engineering-secret-key-prod-2026

# Relational Database Configuration (PostgreSQL / SQLite fallback)
# Docker Compose inter-container: postgresql+psycopg2://postgres:<password>@webmap-db-1:5432/rhd_adds
# Direct host systemd service:    postgresql+psycopg2://postgres:<password>@127.0.0.1:5433/rhd_adds
DATABASE_URL=postgresql+psycopg2://postgres:postgres@webmap-db-1:5432/rhd_adds
SQLITE_FALLBACK_URL=sqlite:///./rhd_adds_fallback.db

# External GIS & Spatial Integrations
WEBMAP_BASE_URL=https://webmap.rhdbridge.com

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://acqform.rhdbridge.com,https://acq.rhdbridge.com,https://webmap.rhdbridge.com,https://rhdbridge.com,http://127.0.0.1:8787,http://localhost:8787
