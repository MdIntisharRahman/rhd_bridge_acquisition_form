# RHD-ADDS Server Configuration
PORT=8787
ENVIRONMENT=development
SECRET_KEY=rhd-adds-precision-engineering-secret-key-2026

# Relational Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rhd_adds
SQLITE_FALLBACK_URL=sqlite:///./rhd_adds_fallback.db

# GIS & Webmap Integration
WEBMAP_BASE_URL=https://webmap.rhdbridge.com

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173,http://127.0.0.1:5173,https://webmap.rhdbridge.com
